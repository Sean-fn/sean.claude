{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "dummy",
    "ANTHROPIC_BASE_URL": "http://localhost:4000",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5",
    "ANTHROPIC_MODEL": "claude-opus-5",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-opus-5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(jira me:*)",
      "Bash(jira issue view:*)",
      "Bash(jira issue list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(hf paper:*)",
      "Bash(python3 -c:*)",
      "mcp__beeper__search_chats",
      "mcp__beeper__list_messages",
      "mcp__beeper__get_accounts",
      "mcp__beeper__search",
      "mcp__beeper__get_chat",
      "mcp__beeper__archive_chat",
      "mcp__beeper__set_chat_reminder",
      "mcp__beeper__search_messages",
      "mcp__beeper__search_docs",
      "mcp__context7",
      "mcp__notebooklm-mcp",
      "mcp__local-line-desktop-mcp__get_line_chatroom_history_default",
      "mcp__local-line-desktop-mcp__get_line_chatroom_history_long",
      "mcp__local-line-desktop-mcp__get_line_chatroom_history_short",
      "mcp__local-line-desktop-mcp__send_message_manual",
      "mcp__chrome-devtools-mcp:chrome-devtools",
      "mcp__ado__core_get_identity_ids",
      "mcp__ado__core_list_project_teams",
      "mcp__ado__core_list_projects",
      "mcp__ado__pipelines_download_artifact",
      "mcp__ado__pipelines_get_build_changes",
      "mcp__ado__pipelines_get_build_definition_revisions",
      "mcp__ado__pipelines_get_build_definitions",
      "mcp__ado__pipelines_get_build_log",
      "mcp__ado__pipelines_get_build_log_by_id",
      "mcp__ado__pipelines_get_build_status",
      "mcp__ado__pipelines_get_builds",
      "mcp__ado__pipelines_get_run",
      "mcp__ado__pipelines_list_artifacts",
      "mcp__ado__pipelines_list_runs",
      "mcp__ado__repo_get_branch_by_name",
      "mcp__ado__repo_get_file_content",
      "mcp__ado__repo_get_pull_request_by_id",
      "mcp__ado__repo_get_pull_request_changes",
      "mcp__ado__repo_get_repo_by_name_or_id",
      "mcp__ado__repo_list_branches_by_repo",
      "mcp__ado__repo_list_directory",
      "mcp__ado__repo_list_my_branches_by_repo",
      "mcp__ado__repo_list_pull_request_thread_comments",
      "mcp__ado__repo_list_pull_request_threads",
      "mcp__ado__repo_list_pull_requests_by_commits",
      "mcp__ado__repo_list_pull_requests_by_repo_or_project",
      "mcp__ado__repo_list_repos_by_project",
      "mcp__ado__repo_update_pull_request_thread",
      "mcp__ado__repo_search_commits",
      "mcp__ado__wit_get_query",
      "mcp__ado__wit_get_query_results_by_id",
      "mcp__ado__wit_get_work_item",
      "mcp__ado__wit_get_work_item_attachment",
      "mcp__ado__wit_get_work_item_type",
      "mcp__ado__wit_get_work_items_batch_by_ids",
      "mcp__ado__wit_get_work_items_for_iteration",
      "mcp__ado__wit_list_backlog_work_items",
      "mcp__ado__wit_list_backlogs",
      "mcp__ado__wit_list_work_item_comments",
      "mcp__ado__wit_update_work_item_comment",
      "mcp__ado__wit_list_work_item_revisions",
      "mcp__ado__wit_my_work_items",
      "mcp__ado__wit_query_by_wiql"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(curl * | sh)",
      "Bash(DROP TABLE *)",
      "mcp__ado__pipelines_create_pipeline",
      "mcp__ado__pipelines_update_build_stage",
      "mcp__ado__repo_update_pull_request_reviewers",
      "mcp__ado__wit_add_artifact_link",
      "mcp__ado__wit_update_work_items_batch",
      "mcp__ado__wit_work_item_unlink",
      "mcp__ado__wit_work_items_link",
      "mcp__ado__work_assign_iterations",
      "mcp__ado__work_create_iterations",
      "mcp__ado__work_update_team_capacity"
    ],
    "ask": [
      "mcp__line"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "VOICE_SOURCE=claude bash ~/.claude/hooks/audio/voice_notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read file_path; if echo \"$file_path\" | grep -q '\\.py$'; then pre-commit run --files  \"$file_path\" 2>/dev/null; fi; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys; data=json.load(sys.stdin); path=data.get('tool_input',{}).get('file_path',''); sys.exit(2 if any(p in path for p in ['.env', '.git/', 'secrets.env']) else 0)\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo play_end_sound"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo play_launch_sound"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "VOICE_SOURCE=claude bash ~/.claude/hooks/audio/voice_notify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo ''"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo Sent"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/coralline/statusline.sh"
  },
  "enabledPlugins": {
    "epso-ado-repos@ai-tool": true,
    "sean-skill-creator@sean-marketplace": true,
    "skill-creator@claude-plugins-official": true,
    "task-swarm@sean-marketplace": true,
    "telegram@claude-plugins-official": false,
    "builder@sean-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "ai-tool": {
      "source": {
        "source": "github",
        "repo": "BeyondsoftTaiwan/ai-tool"
      }
    },
    "sean-marketplace": {
      "source": {
        "source": "directory",
        "path": "/home/v-seanfang/sean-marketplace"
      }
    },
    "tool-cc-forge": {
      "source": {
        "source": "directory",
        "path": "/Users/sean/.claude/plugins/marketplaces/local-tool-cc-forge"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "forceLoginMethod": "console",
  "outputStyle": "Explanatory",
  "language": "台灣中文",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754106537142
  },
}
